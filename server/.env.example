# Single shared database: business owners, customers, CSV imports, customer
# feedback, and the churn/RL tables (customer_rs, wrong_predictions) all live
# here. ml-service/.env.example points at the same value.
MONGO_URI=mongodb://localhost:27017/insightgo

# Where the Flask ML microservice (ml-service/predict.py) is running.
ML_SERVICE_URL=http://localhost:5001

# Google Sheets sync (Current Sales Report -> Looker Studio pipeline).
# Leave GOOGLE_SHEET_ID empty to skip syncing. See README "Connecting Looker
# Studio" for the step-by-step Google Cloud setup.
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./credentials/google-service-account.json
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB_NAME=CurrentSalesData
